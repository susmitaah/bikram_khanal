# Contact form email delivery (src/lib/mailer.ts, src/app/api/contact/route.ts).
# Copy this file to .env.local and fill in real values — .env.local is gitignored.

# SMTP credentials used to SEND the mail (e.g. Gmail app password, SendGrid,
# Mailgun, Amazon SES, your host's SMTP, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Address shown in the "From" header. Often the same as SMTP_USER.
CONTACT_FROM_EMAIL=no-reply@example.com

# Where constituent messages are delivered — the politician's registered
# email. Falls back to src/content/site.ts contact.email.href if unset.
CONTACT_TO_EMAIL=info@example.com
